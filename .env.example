# Copy this file to .env and fill in real values. Never commit .env.

# Pi Platform API key from the Pi Developer Portal (App > Settings)
PI_API_KEY=

# Shared secret for /admin.html — send it via the x-admin-token header.
# Generate something long and random, e.g. `openssl rand -hex 24`
ADMIN_TOKEN=

# Port the Express server listens on
PORT=3000

# --- Automatic import from external crypto-venue directories (optional) ---
# Leave these unset to disable background auto-import; use the admin panel's
# manual "取込" button instead. See server/importers/coinmap.js and README.

# If true, imported listings go live immediately (source-badged, but not
# reviewed by a human). If false/unset, they land in the admin pending queue.
IMPORT_AUTO_APPROVE=false

# JSON array of regions to scan periodically, e.g.:
# IMPORT_REGIONS=[{"name":"Fukuoka","lat":33.5904,"lng":130.4017,"radiusKm":15},{"name":"Nagasaki","lat":32.7503,"lng":129.8779,"radiusKm":15}]
IMPORT_REGIONS=

# How often to re-run the scan, in hours (e.g. 24). Requires IMPORT_REGIONS.
IMPORT_INTERVAL_HOURS=

# --- Expiry reminder emails (optional) ---
# Sends store owners an email when their listing is about to expire (see
# server/services/mailer.js). Leave unset to disable — the server will just
# skip sending and log a warning instead of erroring.
#
# Uses Gmail SMTP with an App Password (NOT your normal Gmail password):
# 1. Turn on 2-Step Verification for the Google account, if not already on:
#    https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Set the two values below.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# How many days before a listing expires to send the reminder (default 14)
REMINDER_DAYS_BEFORE=14

# Base URL used in the reminder email's "renew here" link. Defaults to the
# production URL if unset — you shouldn't need to set this.
APP_URL=

# MongoDB Atlas — Render の無料プランはディスクが再デプロイ毎に消えるため、
# データはこの MongoDB Atlas（無料枠）に保存します。
MONGODB_URI=
MONGODB_DB_NAME=
